# ---------------------------------------------------------------------------
# RoBen RidePool - environment variables
# Copy this file to `.env` and adjust the values for your machine.
# Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Used by the backend (Prisma) and by docker-compose.
# Local (non-Docker) usage: postgres is exposed on localhost:5432
# Docker usage:            the postgres service is reachable on host `postgres`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/robenridepool

# Credentials for the PostgreSQL container. docker-compose builds the
# container's DATABASE_URL from these three values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=robenridepool

# Host ports (change only if something else already uses them).
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000

# --- Backend ----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Placeholder. Will be used for JWT signing once authentication is implemented.
JWT_SECRET=change_me

# --- Frontend ---------------------------------------------------------------
# Exposed to the browser, so it must keep the NEXT_PUBLIC_ prefix.
# In Docker the browser still reaches the backend through localhost:5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
